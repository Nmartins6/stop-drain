# Conexão com o banco de dados (SQLite local para desenvolvimento)
# Em produção (PostgreSQL): postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Chave secreta para assinatura dos tokens JWT da sessão
# Gere uma chave forte (ex: openssl rand -base64 32) para produção
JWT_SECRET="sua-chave-secreta-jwt-super-segura-aqui"
